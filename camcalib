#!/usr/bin/env bash
#
# camcalib: camera / multi-camera / camera-IMU calibration in a box (Kalibr inside Docker).
#
# Image: swarmbotix/sb_kalibr:latest (pulled automatically on first run).
# Local build only as a fallback: bash forge/build.bash
#
# Usage:
#   ./camcalib [calibrate] [FOLDER] [--out DIR] [kalibr options]   FOLDER defaults to the current directory
#   ./camcalib capture <script> [args]       live capture / target detection (needs X11 + /dev/video*)
#   ./camcalib shell  [FOLDER]               interactive shell inside the container
#   ./camcalib inspect [FOLDER]              describe the input folder, no calibration
#   ./camcalib build  [build.bash args]      build the image from forge/
#   ./camcalib version
#
# Input folder layout:
#   FOLDER/cam0/*.png            required   (or images directly in FOLDER/, treated as cam0)
#   FOLDER/cam1..camN/*.png      optional   same file names as cam0 = synchronised frames
#   FOLDER/imu0.csv + imu0.yaml  optional   camera-IMU calibration (needs ns-timestamp file names)
#   FOLDER/target.yaml           optional   overrides the default target (april_6x10_40mm.yaml at repo root)
#   FOLDER/calib.yaml            optional   per-folder defaults (models, step, max_frames, focal, ...)
#
# Output (default FOLDER/calib, or --out DIR):
#   cam<k>/camchain.yaml  rig/camchain.yaml (N>=2)  imu/camchain-imucam.yaml (with IMU)  manifest.json  log.txt
#
# Calibration options are passed through to the container; see `./camcalib calibrate --help`.
# Environment:
#   CAMCALIB_IMAGE   image to run (default swarmbotix/sb_kalibr:latest, pulled on first use)
#   CAMCALIB_DEV=1   mount forge/api over the baked API (edit scripts without rebuilding)
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE="${CAMCALIB_IMAGE:-swarmbotix/sb_kalibr:latest}"
DEFAULT_TARGET="$REPO/april_6x10_40mm.yaml"

usage() { sed -n '3,30p' "$0"; }

die() { echo "camcalib: $*" >&2; exit 1; }

need_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  echo "camcalib: image $IMAGE not found locally; pulling (one time, ~7 GB) ..." >&2
  docker pull "$IMAGE" && return 0
  die "image $IMAGE could not be pulled. Check network / docker login, or build locally: camcalib build"
}

DEV=(); [ "${CAMCALIB_DEV:-0}" = 1 ] && DEV=(-v "$REPO/forge/api:/opt/camcalib:ro")

# Resolve FOLDER argument (first non-option arg) and --out DIR from the arg list;
# pass everything else through.
parse_folder_args() {
  FOLDER=""; OUT=""; PASS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) OUT="$2"; shift 2 ;;
      --out=*) OUT="${1#--out=}"; shift ;;
      -h|--help) PASS+=("--help"); shift ;;
      --*) PASS+=("$1"); shift
           # options that take a value (keep in sync with calibrate.sh)
           case "${PASS[-1]}" in
             --target|--step|--max-frames|--focal|--camchain|--imu-models|--mi-tol|--approx-sync)
               [ $# -gt 0 ] && { PASS+=("$1"); shift; } ;;
             --models)
               while [ $# -gt 0 ] && [[ "$1" != --* ]]; do PASS+=("$1"); shift; done ;;
           esac ;;
      *) if [ -z "$FOLDER" ]; then FOLDER="$1"; else PASS+=("$1"); fi; shift ;;
    esac
  done
  FOLDER="$(realpath "${FOLDER:-.}")"
  OUT="$(realpath -m "${OUT:-$FOLDER/calib}")"
}

# Common docker run arguments for data-processing subcommands (fills MOUNTS).
data_mounts() {
  local ro="$1"
  MOUNTS=(-v "$FOLDER:/input:$ro" -v "$OUT:/output" -e "TZ=${TZ:-$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)}")
  [ -f "$DEFAULT_TARGET" ] && MOUNTS+=(-v "$DEFAULT_TARGET:/defaults/target.yaml:ro" -e "CAMCALIB_TARGET_NAME=$(basename "$DEFAULT_TARGET")")
}

cmd="${1:-calibrate}"
case "$cmd" in
  calibrate|capture|shell|inspect|build|version|-h|--help|help) shift ;;
  *) cmd=calibrate ;;   # first arg is a FOLDER path or an option
esac

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;

  build)
    exec bash "$REPO/forge/build.bash" "$@"
    ;;

  version)
    need_image
    echo "camcalib host script : $REPO/camcalib"
    echo "image                : $IMAGE"
    exec docker run --rm "$IMAGE" version
    ;;

  inspect)
    need_image
    parse_folder_args "$@"
    [ -d "$FOLDER" ] || die "input folder not found: $FOLDER"
    exec docker run --rm -v "$FOLDER:/input:ro" "${DEV[@]}" "$IMAGE" \
      shell -c 'python3 /opt/camcalib/inspect_input.py /input'
    ;;

  calibrate)
    need_image
    parse_folder_args "$@"
    [ -d "$FOLDER" ] || die "input folder not found: $FOLDER"
    mkdir -p "$OUT" || die "cannot create output folder: $OUT"
    [ "$OUT" = "$FOLDER" ] && die "--out must differ from the input folder"
    echo "camcalib: input=$FOLDER"
    echo "camcalib: out=$OUT"
    data_mounts ro
    exec docker run --rm \
      --user "$(id -u):$(id -g)" \
      "${MOUNTS[@]}" "${DEV[@]}" \
      "$IMAGE" calibrate "${PASS[@]}"
    ;;

  shell)
    need_image
    parse_folder_args "$@"
    MOUNTS=()
    if [ -d "$FOLDER/cam0" ] || ls "$FOLDER"/*.png >/dev/null 2>&1; then
      mkdir -p "$OUT"; data_mounts rw
    fi
    exec docker run --rm -it \
      --network host \
      -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1 \
      -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
      "${MOUNTS[@]}" "${DEV[@]}" \
      "$IMAGE" shell
    ;;

  capture)
    need_image
    # capture <script> [args]; frames go to $CAMCALIB_CAPTURE_DIR (default ./capture_out) as /output
    OUT="$(realpath -m "${CAMCALIB_CAPTURE_DIR:-$PWD/capture_out}")"; mkdir -p "$OUT"
    exec docker run --rm -it \
      --network host --privileged \
      -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1 \
      -e CAPTURE_DIR=/output/cam0 \
      -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
      -v /dev:/dev \
      -v "$OUT:/output" \
      -v "$DEFAULT_TARGET:/defaults/target.yaml:ro" \
      "${DEV[@]}" \
      "$IMAGE" capture "$@"
    ;;
esac
